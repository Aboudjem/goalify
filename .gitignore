.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace

# --- Tooling ---
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.cache/
.omc/
.claude/

# build journal (local resumability only)
docs/audit/
